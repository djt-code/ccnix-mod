#!/bin/sh
# craftix-tun-setup: make the TUN device the Craftix Gateway's helper
# attaches to.  Run it as root, once a boot (a systemd unit, rc.local).
#
#   craftix-tun-setup USER [ADDRESS/LEN [NETWORK/LEN...]]
#
#   USER      the user the Minecraft server runs as: the device is theirs,
#             so craftix-tun needs no privileges
#   ADDRESS   the server's address on the device: the gateway's address in
#             the mod's config (10.0.0.1/24 unless you changed it), so
#             packets CC sends to the gateway reach the server
#   NETWORK   CC's networks behind CC routers, the mod's routes (or one
#             network holding them all, 10.0.0.0/8): the server sends
#             their packets into the device too
#
# From the environment:
#   DEVICE=craftix0   the device's name (the mod's tun.device)
#   FORWARD=1         turn on IPv4 forwarding, so the server routes between
#                     CC's networks (through the gateway) and its own
#   NAT=eth0          and masquerade CC's networks going out of eth0, so
#                     the real network needn't know about them (FORWARD too)
#
#   craftix-tun-setup minecraft 10.0.0.1/24 10.1.0.0/16
#   NAT=eth0 craftix-tun-setup minecraft 10.0.0.1/24 10.0.0.0/8
#
# Running it again changes nothing that's already right.
set -e

if [ $# -lt 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    sed -n '2,26s/^# \{0,1\}//p' "$0"
    exit 2
fi
user=$1
addr=${2:-10.0.0.1/24}
[ $# -gt 1 ] && shift 2 || shift
dev=${DEVICE:-craftix0}

ip link show "$dev" >/dev/null 2>&1 || ip tuntap add dev "$dev" mode tun user "$user"
ip addr replace "$addr" dev "$dev"
ip link set "$dev" up
for net in "$@"; do
    ip route replace "$net" dev "$dev"
done

if [ -n "$FORWARD" ] || [ -n "$NAT" ]; then
    sysctl -q -w net.ipv4.ip_forward=1
fi
if [ -n "$NAT" ]; then
    for net in "$addr" "$@"; do
        iptables -t nat -C POSTROUTING -s "$net" -o "$NAT" -j MASQUERADE 2>/dev/null ||
            iptables -t nat -A POSTROUTING -s "$net" -o "$NAT" -j MASQUERADE
    done
fi

echo "$dev: $addr, for $user${*:+; routes $*}${NAT:+; masquerading out of $NAT}"
