#!/bin/sh
# ccnix-tun-setup: make the TUN device the ccnix's helper
# attaches to.  Run it as root, once a boot (a systemd unit, rc.local).
#
#   ccnix-tun-setup USER [ADDRESS/LEN [NETWORK/LEN...]]
#   ccnix-tun-setup --remove       take it all down (the gateway in NAT mode)
#
#   USER      the user the Minecraft server runs as: the device is theirs,
#             so ccnix-tun needs no privileges
#   ADDRESS   the server's address on the device: the gateway's address in
#             the mod's config (10.0.0.1/24 unless you changed it), so
#             packets CC sends to the gateway reach the server
#   NETWORK   CC's networks behind CC routers (the mod's gateway.networks):
#             the server sends their packets into the device. The gateway's
#             routes, ops' included, have to be inside these.
#
# The networks go in a routing table of their own, TABLE, looked at after
# the host's own routes (all but its default route: the rule "lookup main
# suppress_prefixlength 0" comes first).  So a network here can never take
# the host's LAN, its gateway or any route it has: it only stands in for
# the default route, for the addresses in it.  systemd-networkd deletes
# rules it didn't make when it starts: run this again after, or give it
#   ManageForeignRoutingPolicyRules=no   (in /etc/systemd/networkd.conf.d)
#
# From the environment:
#   DEVICE=ccnix0   the device's name (the mod's tun.device)
#   TABLE=25565     the routing table (the Minecraft port), and the rules'
#                   priorities: TABLE for the host's own routes, TABLE + 1
#                   for the table (below 32766, so TABLE 32764 at most)
#   FORWARD=1       turn on IPv4 forwarding, so the server routes between
#                   CC's networks (through the gateway) and its own
#   NAT=eth0        and masquerade CC's networks going out of eth0, so
#                   the real network needn't know about them (FORWARD too)
#   SRCFILTER=1     BCP 38: drop what comes out of the device from a source
#                   that isn't ADDRESS's network or a NETWORK (iptables
#                   chain DEVICE-src, from INPUT and FORWARD); 0 takes it
#                   away.  The mod drops those too (gateway.sourceCheck):
#                   this is the host's own line, should that be off
#
#   ccnix-tun-setup minecraft 10.0.0.1/24 10.1.0.0/16
#   NAT=eth0 ccnix-tun-setup minecraft 10.0.0.1/24 10.1.0.0/16 10.2.0.0/16
#
# Running it again leaves things as it says, whatever was there before.
set -e

if [ $# -lt 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
    sed -n '2,43s/^# \{0,1\}//p' "$0"
    exit 2
fi

# ccnix-mod before 0.14.0 used table 4040 (rules 4040 and 4041): those go
# when it's another table now, matched exactly, so no one else's rule does
legacy() {
    [ "$table" = 4040 ] && return 0
    ip rule del pref 4040 lookup main suppress_prefixlength 0 2>/dev/null || true
    ip rule del pref 4041 lookup 4040 2>/dev/null || true
    ip route flush table 4040 dev "$dev" 2>/dev/null || true
}
if [ "$1" = "--remove" ]; then
    dev=${DEVICE:-ccnix0}
    table=${TABLE:-25565}
    legacy
    ip link del "$dev" 2>/dev/null || true
    if command -v iptables >/dev/null 2>&1; then
        for c in INPUT FORWARD; do
            while iptables -D "$c" -i "$dev" -j "$dev-src" 2>/dev/null; do :; done
        done
        iptables -F "$dev-src" 2>/dev/null && iptables -X "$dev-src" || true
    fi
    ip route flush table "$table" 2>/dev/null || true
    while ip rule del pref "$table" 2>/dev/null; do :; done
    while ip rule del pref $((table + 1)) 2>/dev/null; do :; done
    echo "$dev: removed, with table $table, its rules and the $dev-src chain (forwarding and masquerading left as they were)"
    exit 0
fi
user=$1
addr=${2:-10.0.0.1/24}
[ $# -gt 1 ] && shift 2 || shift
dev=${DEVICE:-ccnix0}
table=${TABLE:-25565}
case $table in
    *[!0-9]* | "") echo "TABLE=$table: give a number" >&2; exit 2;;
esac
if [ "$table" -lt 1 ] || [ "$table" -gt 32764 ]; then
    echo "TABLE=$table: 1-32764 (it's the rules' priority too, and those stop at 32765)" >&2
    exit 2
fi
legacy

ip link show "$dev" >/dev/null 2>&1 || ip tuntap add dev "$dev" mode tun user "$user"
ip addr replace "$addr" dev "$dev"
ip link set "$dev" up

# the networks, in their table and nowhere else (older versions put them in main)
ip route flush dev "$dev" proto boot 2>/dev/null || true
ip route flush table "$table" 2>/dev/null || true
for net in "$@"; do
    ip route replace "$net" dev "$dev" table "$table"
done
while ip rule del pref "$table" 2>/dev/null; do :; done
while ip rule del pref $((table + 1)) 2>/dev/null; do :; done
ip rule add pref "$table" lookup main suppress_prefixlength 0
ip rule add pref $((table + 1)) lookup "$table"

if [ -n "$FORWARD" ] || [ -n "$NAT" ]; then
    sysctl -q -w net.ipv4.ip_forward=1
fi
if [ -n "$NAT" ]; then
    for net in "$addr" "$@"; do
        iptables -t nat -C POSTROUTING -s "$net" -o "$NAT" -j MASQUERADE 2>/dev/null ||
            iptables -t nat -A POSTROUTING -s "$net" -o "$NAT" -j MASQUERADE
    done
fi

# BCP 38: only CC's own sources out of the device (the chain says which)
chain="$dev-src"
filter=""
if command -v iptables >/dev/null 2>&1; then
    for c in INPUT FORWARD; do
        while iptables -D "$c" -i "$dev" -j "$chain" 2>/dev/null; do :; done
    done
    iptables -F "$chain" 2>/dev/null && iptables -X "$chain" || true
    if [ "${SRCFILTER:-1}" != 0 ]; then
        iptables -N "$chain"
        for net in "$addr" "$@"; do
            iptables -A "$chain" -s "$net" -j RETURN
        done
        iptables -A "$chain" -j DROP
        for c in INPUT FORWARD; do
            iptables -I "$c" -i "$dev" -j "$chain"
        done
        filter="; sources filtered ($chain)"
    fi
elif [ "${SRCFILTER:-1}" != 0 ]; then
    echo "$dev: no iptables, so the host doesn't filter CC's sources (the mod's gateway.sourceCheck still does)" >&2
fi

echo "$dev: $addr, for $user${*:+; routes $* (table $table)}${NAT:+; masquerading out of $NAT}$filter"
