[gateway]
	address = "{{ ccnix_gateway_address }}"
	channel = {{ ccnix_gateway_channel }}
	mac = "{{ ccnix_gateway_mac }}"
	routes = [{{ ccnix_gateway_routes | map('to_json') | join(', ') }}]
	opRoutes = {{ ccnix_op_routes | bool | lower }}
	opMaxSubnet = {{ ccnix_op_route_max_subnet }}

[tun]
	helper = "ccnix-tun"
	device = "{{ ccnix_tun_device }}"
